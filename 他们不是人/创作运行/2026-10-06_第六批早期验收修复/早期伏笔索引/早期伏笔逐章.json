          "prose_sha256": "421bd6db9df14d57f51e941ad2cff493ad488450d38c7b176ad2e042ca6cc5f0",
          "prose_refs": [
            {
              "line": 17,
              "exact_prose_line": "猫眼午后进店。她把一摞纸质旧版本拍在柜台上：打印页、旧网页纸本、分散来源的复印件。纸边用她的习惯写着校验和出处。从当初查十七号起，她总是先把纸摊开，再谈屏幕上的版本。"
            },
            {
              "line": 21,
              "exact_prose_line": "镜辞翻了两页。缴费栏连一次补交都没有。纸上的整齐还不能证明哪一项是假的，他在页边标了个问号。"
            }
          ],
          "core_master_sha256": "e3d049f3157daec91534efc58522b6e09c916b8e26147045c1d979c09841eab9",
          "core_master_section_line": 127,
          "tracking_r175_sha256": "b1c1485bd588e2bf59052584cb64a33695fe0b00cc1f8fbeab78fe36282a0867"
        },
        {
