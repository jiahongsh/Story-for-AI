    "042": {
      "chapter": 42,
      "prose_path": "正文/第042章_他今天做的事.md",
      "prose_sha256": "2e886810a7164da703c33b4876b2bdb4a82bbc8c5c3fcfc8315cbfb90db51720",
      "coverage": "限定证据已核；本章其他CORE项仍待逐条核对",
      "core_evidence": [
        {
          "namespace": "CORE",
          "core_id": "F09",
          "phase": "推进",
          "limited_claim": "空白姓名页影响镜辞的方法选择；眼前存在拒借旧同学群替他查照片并主动取消旧称呼留位，关系后果落实。",
          "prose_sha256": "2e886810a7164da703c33b4876b2bdb4a82bbc8c5c3fcfc8315cbfb90db51720",
          "prose_refs": [
            {
              "line": 95,
              "exact_prose_line": "工作台另一边还压着当前存在的空白姓名页。镜辞早就给那一页分开记过继承的旧记忆和醒来后的选择，轮到一个更让他警惕的人，记录方法却悄悄变了。"
            },
            {
              "line": 107,
              "exact_prose_line": "“他们下一句就会问我什么时候回来。”她说，“群里在约周末吃饭，还替那个名字留着位子。我连去不去都没答。你现在让我进去问她的照片，我怎么开口？”"
            },
            {
              "line": 113,
              "exact_prose_line": "电话挂了几分钟，她发来两条截出的群消息。第一条是她刚写的：周末不去，不用留座。第二条来自约饭的人：行，人数今天要定。我就不留位了。没有其他人的头像和聊天，镜辞只看见那个位子被取消了。"
            },
            {
              "line": 115,
              "exact_prose_line": "他打出“那明天呢”，停了一会儿，删掉。照片还没找到，借她的群号询问的草稿也被他取消。他另记下缺少的照片来源，没有替她向同学解释北河，更没把这次不去写成她以后都不认旧人。"
            }
          ],
          "core_master_sha256": "e3d049f3157daec91534efc58522b6e09c916b8e26147045c1d979c09841eab9",
          "core_master_section_line": 230,
          "tracking_r175_sha256": "b1c1485bd588e2bf59052584cb64a33695fe0b00cc1f8fbeab78fe36282a0867"
        }
      ]
    },
