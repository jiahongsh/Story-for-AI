    "097": {
      "chapter": 97,
      "prose_path": "正文/第097章_前三年.md",
      "prose_sha256": "7a936d3f7b62ea90a5adcff5fa3236b15d1472f708b07f718a718eeead179502",
      "coverage": "限定证据已核；本章其他CORE项仍待逐条核对",
      "core_evidence": [
        {
          "namespace": "CORE",
          "core_id": "F03",
          "phase": "推进",
          "limited_claim": "独立旧版与现系统冲突，最早三年存在回填痕迹；实施者和当年事实仍待核。",
          "prose_sha256": "7a936d3f7b62ea90a5adcff5fa3236b15d1472f708b07f718a718eeead179502",
          "prose_refs": [
            {
              "line": 5,
              "exact_prose_line": "六年前社区纸质住户汇总表上，临江某址当时登记的是另一名租客。一家已倒闭快递点留下的交接本，同日期签收人是另一个名字。旧网页缓存和房屋出租页面也能定年。这些旧来源和现系统正面冲突。冲突只能证明一件事：当前数字履历至少有一部分，是后来版本里被改写或回填过的。"
            },
            {
              "line": 7,
              "exact_prose_line": "镜辞不碰周衡。他只帮着辨两样东西：哪几处能钉死后来被人改过版本，哪几处还钉不死当年根本没发生。他拒绝一笔抹掉早年三年。落笔只许写：最早三年有系统性被重写的痕迹；哪些事当时真发生过，还得逐条核。未知保住后路。后路是部分过去可能是真的，部分被归并。"
            },
            {
              "line": 13,
              "exact_prose_line": "镜辞在私人本上写：身份历史存在版本级回填。笔尖停了停，才在下一行添上：实施者未知。"
            }
          ],
          "core_master_sha256": "e3d049f3157daec91534efc58522b6e09c916b8e26147045c1d979c09841eab9",
          "core_master_section_line": 127,
          "tracking_r175_sha256": "b1c1485bd588e2bf59052584cb64a33695fe0b00cc1f8fbeab78fe36282a0867"
        },
        {
          "namespace": "CORE",
          "core_id": "F11",
          "phase": "推进",
          "limited_claim": "旧纸表、交接本、缓存等互不隶属的版本被保留并与近年材料分开。",
          "prose_sha256": "7a936d3f7b62ea90a5adcff5fa3236b15d1472f708b07f718a718eeead179502",
          "prose_refs": [
            {
              "line": 5,
              "exact_prose_line": "六年前社区纸质住户汇总表上，临江某址当时登记的是另一名租客。一家已倒闭快递点留下的交接本，同日期签收人是另一个名字。旧网页缓存和房屋出租页面也能定年。这些旧来源和现系统正面冲突。冲突只能证明一件事：当前数字履历至少有一部分，是后来版本里被改写或回填过的。"
            },
            {
              "line": 31,
              "exact_prose_line": "镜辞回：收。旧市场的灯一盏盏灭了。他把纸上的冲突页与近五年的材料分开收好。哪段历史被改过，有了证据；谁改的、当年的周衡又是谁，还得另查。"
            }
          ],
          "core_master_sha256": "e3d049f3157daec91534efc58522b6e09c916b8e26147045c1d979c09841eab9",
          "core_master_section_line": 259,
          "tracking_r175_sha256": "b1c1485bd588e2bf59052584cb64a33695fe0b00cc1f8fbeab78fe36282a0867"
        }
      ]
    },
    "098": {
      "chapter": 98,
      "prose_path": "正文/第098章_后五年.md",
      "prose_sha256": "b98aad3b68c5b82eed9946feeab9908b689c9d2d7b1b1cc9fe4487465276613e",
      "coverage": "限定证据已核；本章其他CORE项仍待逐条核对",
      "core_evidence": [
        {
          "namespace": "CORE",
          "core_id": "F03",
          "phase": "推进",
          "limited_claim": "近五年留下分散的现实关系后果；正文明确把早期回填与后五年选择并列，身份结论继续开放。",
          "prose_sha256": "b98aad3b68c5b82eed9946feeab9908b689c9d2d7b1b1cc9fe4487465276613e",
          "prose_refs": [
            {
              "line": 5,
              "exact_prose_line": "修鞋摊老板住院那阵，周衡替他看过三天摊。赵奶奶摔伤，他送去社区医院，挂号小票和邻居记忆能对上。东口有小孩走丢过一次，是他把孩子领回来。一名同事搬家借过他的车，后来又帮他修过水管。材料散在聊天、支付、旧照片、邻里口述和现场痕迹里。没有人预先按“证明他存在”的目标去存档。留下来的，多半只是过日子顺手蹭出的毛边。"
            },
            {
              "line": 9,
              "exact_prose_line": "猫眼最初落笔，想写身份旁证在近五年被加厚。镜辞把句子改短：这个人近五年留下了大量独立关系后果。那些后果先归这五年真正做选择的人。他跟“原来的周衡”是不是同一个，这题仍空着。"
            },
            {
              "line": 11,
              "exact_prose_line": "他把两条并排写进私人本：早期身份历史存在回填；近五年的关系后果确实发生过。笔放下后，他又把两页纸分开压好。一页问过去被谁改过，一页留着那些真正与周衡吵过、互相帮过的人。"
            }
          ],
          "core_master_sha256": "e3d049f3157daec91534efc58522b6e09c916b8e26147045c1d979c09841eab9",
          "core_master_section_line": 127,
          "tracking_r175_sha256": "b1c1485bd588e2bf59052584cb64a33695fe0b00cc1f8fbeab78fe36282a0867"
        },
        {
          "namespace": "CORE",
          "core_id": "F11",
          "phase": "推进",
          "limited_claim": "猫眼及镜辞把旧冲突页与近五年的独立关系材料分开保存，不让一个版本吞掉另一版。",
          "prose_sha256": "b98aad3b68c5b82eed9946feeab9908b689c9d2d7b1b1cc9fe4487465276613e",
          "prose_refs": [
            {
              "line": 3,
              "exact_prose_line": "纸上的前三年还发着冲突的光。光旁边，猫眼又摊开近五年。近五年不看漂亮统一的系统履历，去找别人日子里被他改过的地方。"
            },
            {
              "line": 11,
              "exact_prose_line": "他把两条并排写进私人本：早期身份历史存在回填；近五年的关系后果确实发生过。笔放下后，他又把两页纸分开压好。一页问过去被谁改过，一页留着那些真正与周衡吵过、互相帮过的人。"
            }
          ],
          "core_master_sha256": "e3d049f3157daec91534efc58522b6e09c916b8e26147045c1d979c09841eab9",
          "core_master_section_line": 259,
          "tracking_r175_sha256": "b1c1485bd588e2bf59052584cb64a33695fe0b00cc1f8fbeab78fe36282a0867"
        }
      ]
    },
    "099": {
      "chapter": 99,
      "prose_path": "正文/第099章_一只真的坏表.md",
      "prose_sha256": "4b096cbd58cca3a230358d1a086727c53f11ca00847a612eab005a9d110760b5",
      "coverage": "限定证据已核；本章其他CORE项仍待逐条核对",
      "core_evidence": [
        {
          "namespace": "CORE",
          "core_id": "F03",
          "phase": "边界维持",
          "limited_claim": "周衡到店修表，近距观察仍未见缝；正常维修发生，但无法据此判定身份。",
          "prose_sha256": "4b096cbd58cca3a230358d1a086727c53f11ca00847a612eab005a9d110760b5",
          "prose_refs": [
            {
              "line": 21,
              "exact_prose_line": "周衡点头。点头时侧脸对着柜台玻璃。镜辞自然看过去：侧脸、手背、颈侧。第一式扫过一遍。没有稳定接缝。柜台玻璃忽然反光，轮廓像错开半毫。错开只停一瞬。一瞬后仍是普通人的边。他在私人本落半行：近距首触，接缝未立。半行旁边不写“伪装成功”。"
            },
            {
              "line": 25,
              "exact_prose_line": "镜辞按普通流程写维修单：周衡。机械表。走时偏差。明日取。写完把单子推过去。周衡看了一眼，说声麻烦，起身走了。走的时候没回头。今天他第一次以普通客人身份坐到工作台前。坐过之后，案子仍在纸上，表仍在灯下。"
            }
          ],
          "core_master_sha256": "e3d049f3157daec91534efc58522b6e09c916b8e26147045c1d979c09841eab9",
          "core_master_section_line": 127,
          "tracking_r175_sha256": "b1c1485bd588e2bf59052584cb64a33695fe0b00cc1f8fbeab78fe36282a0867"
        }
      ]
    }
  }
