      "id": "E022",
      "objective_fact": "镜辞、姜霁、芽在零号外围门前配合破甲斩杀三阶半机械官严彻并剪断封井高爆雷夺下摔裂便携终端；三人推入零号外围排废中廊见两具被陈屿剥走双臂且缝口齐整的白塔先遣尸骸与血字，陈屿换臂退向深井底座，便携终端骤然亮起微光。",
      "reader_knowledge": "读者见证三人零耗第3格怀表智杀重甲清道夫，却随临死漏底与悬尸血字骇然惊觉陈屿已在井下生吞白塔先遣换装强臂，兜里碎终端重亮引出新悬念。",
      "reveal_chapter": 22,
      "reveal_status": "部分揭示",
      "story_time": "第四日午后一点一刻至两点十五分",
      "updated_chapter": 22
    },
    "E023": {
      "characters": [
        "镜辞",
        "姜霁",
        "芽",
        "陈屿"
      ],
      "first_recorded_chapter": 23,
      "id": "E023",
      "objective_fact": "姜霁读出碎终端「第8次抹除·余2接触者」与「22:17并入零号主洗」彻底归队；三人破铅门入三十米零号外井见十倍漆黑巨钟，独木铁桥遭遇双肩黑金线接装四阶电弧铜臂的陈屿扑斩，桥头石缝现沈竹「零号表芯不在壳里，在……」半截壳盖与微湿半印。",
      "reader_knowledge": "读者见姜霁看清抹除八次实录彻底站回镜辞背后，随即随众人闯入十倍零号巨钟基座，直面换臂陈屿与沈竹断字壳盖兼湿印的双重高潮对撞。",
      "reveal_chapter": 23,
      "reveal_status": "部分揭示",
      "story_time": "第四日午后两点十五分至四十五分",
      "updated_chapter": 23
    },
    "E024": {
      "characters": [
        "镜辞",
        "姜霁",
        "芽",
        "陈屿"
      ],
      "first_recorded_chapter": 24,
      "id": "E024",
      "objective_fact": "三尺铁桥交锋中，姜霁点射破缝、芽借陈屿电弧引爆老火药饼炸废左四阶臂，镜辞守第3格不耗借余火反光三秒照缝后以淬火钢倒钩硬扯断其右四阶铜臂坠井；陈屿跌退巨钟基座露出胸心直连巨钟暗槽之黑金共生线，狂撞手动阀门半格迫使顶管抽雾暴颤。",
      "reader_knowledge": "读者畅快目睹铁三角借手艺、火药与倒钩彻底扯废陈屿双四阶铜臂，随即被疯狗露出共生金丝强开半格抽吸阀拉东巷陪葬的惊险悬念抓紧心神。",
      "reveal_chapter": 24,
      "reveal_status": "部分揭示",
      "story_time": "第四日午后两点四十五分至三点零二分",
      "updated_chapter": 24
    },
    "E025": {
      "characters": [
        "镜辞",
        "姜霁",
        "芽",
        "陈屿",
        "顾横"
      ],
      "first_recorded_chapter": 25,
      "id": "E025",
      "objective_fact": "三人协力破膝卡齿、锁簧断丝碎核斩死陈屿并闭阀，撬开巨钟护板见核心早在七年前被挖空大半仅余外管伪芯；取回沈竹半截壳盖循泥印摸至砖缝雾口兼蓝布线头时，巨钟副核失联暴走且顾横急电东巷三点已遭重围。",
      "reader_knowledge": "读者见证裁缝陈屿彻底伏诛沉井，随拆开空心巨钟与砖缝泥印窥见沈竹七年前壮举一角，随即被巨钟暴走及白塔提前强拆东巷的生死危局拽回旧街战场。",
      "reveal_chapter": 25,
      "reveal_status": "部分揭示",
      "story_time": "第四日午后三点零二分至三点三十分",
      "updated_chapter": 25
    },
    "E026": {
      "characters": [
        "镜辞",
        "姜霁",
        "芽",
        "顾横"
      ],
      "first_recorded_chapter": 26,
      "id": "E026",
      "objective_fact": "三人逃入三十米变电暗井遭焊盖电网与暴走无皮空壳上下夹杀，姜霁打掉六发余二十三发、芽炸光最后老火药饼轰松铁盖险跌白雾，镜辞强开卡齿（3格跌1格）停摆两秒压平井喷破盖脱身；雨地中芽死锁呕血抵死记住镜辞、顾横手写代号缺白，三人直扑受围东巷。",
      "reader_knowledge": "读者紧绷目睹镜辞绝境硬拧怀表跌进最后第1格危险区，见证芽拼血死记名字与顾横纸条抹白的刺骨寒意，迫不及待看下章东巷守钟人是否还能认出他。",
      "reveal_chapter": 26,
      "reveal_status": "部分揭示",
      "story_time": "第四日午后三点三十分至四十五分",
      "updated_chapter": 26
    },
    "E027": {
      "characters": [
        "顾横",
        "镜辞",
        "姜霁",
        "芽",
        "守钟人",
        "程晦"
      ],
      "first_recorded_chapter": 27,
      "id": "E027",
      "objective_fact": "顾横轰胎截断南口，镜辞三人凭四发银弹、豆腐架与液压黑油混水救出守钟人，守钟人受第1格擦除陌生问贵姓，程晦撑四阶声盾封死门口。",
      "reader_knowledge": "读者看清第1格彻底抹净了守钟人七年情分却仍逼不住主角抬锤挡门，紧盯姜霁手按战术袋里的短杖拆件如何对付三丈外深水坑重甲。",
      "reveal_chapter": 27,
      "reveal_status": "部分揭示",
      "story_time": "第四日午后四点零五分",
      "updated_chapter": 27
    },
    "E028": {
      "characters": [
        "镜辞",
        "姜霁",
        "芽",
        "守钟人",
        "顾横",
        "程晦",
        "老陈"
      ],
      "first_recorded_chapter": 28,
      "id": "E028",
      "objective_fact": "姜霁耗短杖件与4发银弹破盾，三人联手照缝锁簧碎炉击败程晦夺清拆黑令；老陈陌生畏缩避镜辞，后堂青砖崩裂狂喷参号失衡冻雾。",
      "reader_knowledge": "读者在痛快智杀四阶重甲后刚见街坊视主角如陌路恶客，紧接着被崩裂喷雾的参号青砖拉向第一卷最后两章终局。",
      "reveal_chapter": 28,
      "reveal_status": "部分揭示",
      "story_time": "第四日午后四点二十五分",
      "updated_chapter": 28
    },
    "E029": {
      "characters": [
        "镜辞",
        "姜霁",
        "芽",
        "守钟人",
        "顾横"
      ],
      "first_recorded_chapter": 29,
      "id": "E029",
      "objective_fact": "姜霁四弹灭门外雾兽，镜辞不拧第1格借照缝、血契铜印与沈竹双环残片、铁钳焊封参号地缝；守钟人昏迷保命，黑令背面露出城南医院殡仪续档总库密印。",
      "reader_knowledge": "读者震撼于主角纯手艺零耗强封母表并摸清城南医院新黑产线，紧盯天亮回街的熟人老陈将如何面对这个被彻底忘光的人。",
      "reveal_chapter": 29,
      "reveal_status": "部分揭示",
      "story_time": "第五日凌晨破晓前微明时分",
      "updated_chapter": 29
    },
    "E030": {
      "characters": [
        "镜辞",
        "姜霁",
        "芽",
        "守钟人",
        "徐正",
        "顾横",
        "老郭",
        "老陈"
      ],
      "first_recorded_chapter": 30,
      "id": "E030",
      "objective_fact": "东巷复业如常，黑狗、顾横、老郭、老陈全面视镜辞为外乡陌生匠人；老陈路过叹沈竹未留一儿半女后离去，镜辞与芽携第1格冷表、沈竹残盖与城南医院黑令冷望城南收官第一卷。",
      "reader_knowledge": "读者亲历整条重获安生的人海与唯一救人者被抹名之间的极致残酷温差，同时牢牢记住城南医院殡仪续档线开启第二卷。",
      "reveal_chapter": 30,
      "reveal_status": "已揭示",
      "story_time": "第五日清晨七点五十分至八点",
      "updated_chapter": 30
    }
  },
